# ILLUSION AI - Environment Configuration Example

APP_NAME="ILLUSION AI"
APP_ENV=development
API_V1_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database & Supabase
DATABASE_URL=postgresql://user:password@localhost:5432/illusion_ai
SUPABASE_URL=https://ihldxznnsacyzskwtzye.supabase.co
SUPABASE_SERVICE_ROLE_KEY=postgresql://postgres:[Harish@1630@]@db.ihldxznnsacyzskwtzye.supabase.co:5432/postgres
SUPABASE_ANON_KEY=sb_publishable_badTax5g5c490sefBRLk9g_L11NNVik

# LLM Providers (Groq & Google Gemini)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# Web Search Tool (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Embeddings (Gemini text-embedding-004)
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# Intelligent Router
ROUTER_MAX_STEPS=5
ROUTER_TOOL_TIMEOUT=15.0
MCP_DISCOVERY_ENABLED=False

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Token Encryption Key (Fernet 32-byte url-safe base64 key)
TOKEN_ENCRYPTION_KEY=your_fernet_token_encryption_key_here

# JWT Token Session Management
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


